#!/usr/bin/env bash
# theme-set — switch the active theme across ghostty, nvim, tmux, hyprland, quickshell.
#
# Themes:      ~/.config/themes/<name>/   (chezmoi-managed registry)
# Active copy: ~/.config/themes/current/  (script-owned, NOT chezmoi-managed)
# Name record: ~/.local/state/theme/current
#
# Copy-swap, not symlinks: file watchers (quickshell FileView) need new inodes.
#
# Usage: theme-set [name] · theme-set list · theme-set current
set -euo pipefail

# THEME_SET_DEBUG=1 → timestamp each step to stderr
_dbg() { [[ -z ${THEME_SET_DEBUG:-} ]] || printf '%s %s\n' "$(date +%T.%N)" "$*" >&2; }

themes_dir="$HOME/.config/themes"
state_dir="$HOME/.local/state/theme"
current_dir="$themes_dir/current"

_dbg start

list_themes() {
	find "$themes_dir" -mindepth 1 -maxdepth 1 -type d ! -name current ! -name '.*' -printf '%f\n' | sort
}

case "${1:-}" in
	list)
		list_themes
		exit 0
		;;
	current)
		cat "$state_dir/current" 2>/dev/null || echo "none"
		exit 0
		;;
	"")
		if command -v fzf >/dev/null 2>&1; then
			name=$(list_themes | fzf --prompt='theme> ') || exit 0
		else
			select choice in $(list_themes); do
				name=$choice
				break
			done
			[[ -n ${name:-} ]] || exit 1
		fi
		;;
	*)
		name=$1
		;;
esac

if [[ ! -d $themes_dir/$name ]]; then
	echo "theme '$name' does not exist:" >&2
	list_themes >&2
	exit 1
fi

# swap
tmp="$themes_dir/.next"
rm -rf "$tmp"
mkdir "$tmp"
cp -a "$themes_dir/$name/." "$tmp/"
rm -rf "$current_dir"
mv "$tmp" "$current_dir"

mkdir -p "$state_dir"
printf '%s\n' "$name" >"$state_dir/current"
_dbg swapped

# apply
pkill -SIGUSR2 ghostty 2>/dev/null || true
_dbg ghostty-signalled
hyprctl reload >/dev/null 2>&1 || true
_dbg hypr-reloaded
tmux source-file "$current_dir/tmux.conf" 2>/dev/null || true
_dbg tmux-sourced

# quickshell: FileView watches palette.json, but the swap replaces the whole dir — restart.
# (no hyprctl dispatch exec: the Lua DSL rewrites its syntax)
pkill -x quickshell 2>/dev/null || true
for _ in {1..6}; do
	pgrep -x quickshell >/dev/null 2>&1 || break
	sleep 0.05
done
setsid quickshell >/dev/null 2>&1 &
_dbg quickshell-restarted

# nvim: base46 caches compiled highlights and never recompiles on its own — rebuild for next launch.
# One run is enough: the E5113 from init.lua doffing the not-yet-existing cache is harmless
# (the rebuild still completes) and the output is discarded anyway. This is the slow step (~0.5-1s).
rm -rf "$HOME/.local/share/nvim/base46"
nvim --headless "+lua require('base46').load_all_highlights()" "+qa!" >/dev/null 2>&1 || true
_dbg base46-rebuilt

# running nvim instances: live-switch via server sockets (same recipe as NvChad's theme picker)
nvtheme=$(cat "$current_dir/nvim" 2>/dev/null || true)
if [[ -n $nvtheme ]]; then
	lua_cmd="require('nvconfig').base46.theme='${nvtheme}'; require('base46').load_all_highlights(); local ok=pcall(require,'plenary.reload'); if ok then require('plenary.reload').reload_module('volt.highlights'); require('volt.highlights') end"
	for sock in /run/user/$UID/nvim.*.*; do
		[[ -S $sock ]] || continue
		_dbg "send → $sock"
		# --headless matters: with a TTY on stdout the client starts a terminal
		# probe and waits ~1s for feature responses before sending
		nvim --headless --server "$sock" --remote-send ":lua ${lua_cmd}<CR>" >/dev/null 2>&1 || true
		_dbg "sent ✓ $sock"
	done
	_dbg nvim-live-switched
fi

# obsidian: copy the generated snippet into the vault and ensure it's enabled.
# Vault config is user data — theme-set owns these writes, not chezmoi.
obsidian_vault="$HOME/notes"
if [[ -d $obsidian_vault/.obsidian ]]; then
	obsidian_snippets="$obsidian_vault/.obsidian/snippets"
	mkdir -p "$obsidian_snippets"
	cp -f "$current_dir/obsidian" "$obsidian_snippets/theme-sync.css"
	_dbg obsidian-snippet-copied
	# idempotently add theme-sync to appearance.json cssSnippets
	obsidian_appearance="$obsidian_vault/.obsidian/appearance.json"
	if [[ -f $obsidian_appearance ]]; then
		if command -v python3 >/dev/null 2>&1; then
			python3 - "$obsidian_appearance" <<'PY' || true
import json, sys
p = sys.argv[1]
try:
    with open(p) as f:
        data = json.load(f)
except Exception:
    data = {}
snips = data.get("cssSnippets")
if not isinstance(snips, list):
    snips = []
if "theme-sync" not in snips:
    snips.append("theme-sync")
data["cssSnippets"] = snips
with open(p, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
		fi
	fi
	_dbg obsidian-appearance-updated
	# best-effort reload (obsidian has no signal); xdotool optional
	if command -v xdotool >/dev/null 2>&1; then
		xdotool search --name "Obsidian" key --window "%1" ctrl+r >/dev/null 2>&1 || true
		_dbg obsidian-reloaded
	fi
fi

# bat uses --theme=ansi — follows the terminal palette, nothing to do


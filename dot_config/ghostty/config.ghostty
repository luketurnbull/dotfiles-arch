theme = static-noir
font-size = 12

# opt into the ext-background-effect-v1 blur region — since GTK 4.24 every GTK
# window declares an empty blur region unless the app asks, and Hyprland ≥0.56
# then skips its own blur behind it. 0.99 is invisible; real translucency still
# comes from Hyprland's active_opacity
background-opacity = 0.99
background-blur = true

window-padding-x = 20
window-padding-y = 15

# spread sub-cell leftover pixels across all edges — tiled window heights are
# rarely exact cell multiples, so without this the remainder pools at the bottom
window-padding-balance = true

cursor-style = block

shell-integration = zsh
custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl

# every new terminal starts in tmux — each window gets its own session
command = tmux

confirm-close-surface = false

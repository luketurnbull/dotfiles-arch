{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#0a0a0a",
    "panel": "#101010",
    "element": "#191919",
    "selection": "#333333",
    "mutedDark": "#666666",
    "muted": "#7d7d7d",
    "mutedLight": "#929292",
    "textDim": "#c9c9c9",
    "text": "#ededed",
    "white": "#ffffff",
    "accent": "#ff3b30",
    "red": "#ff4d42",
    "redBright": "#ff6e64",
    "orange": "#f3874f",
    "yellow": "#e6c15c",
    "green": "#9fd08a",
    "greenBright": "#b7e2a3",
    "teal": "#74cfd1",
    "blue": "#7fb2e8",
    "indigo": "#9ba7e0",
    "violet": "#d093d0",
    "pink": "#ef6674",
    "brown": "#cc8b6a",
    "addedBg": "#142014",
    "removedBg": "#241111"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "teal", "light": "teal" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "mutedLight", "light": "mutedLight" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "background", "light": "background" },
    "border": { "dark": "selection", "light": "selection" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "element", "light": "element" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "blue", "light": "blue" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "greenBright" },
    "diffHighlightRemoved": { "dark": "redBright", "light": "redBright" },
    "diffAddedBg": { "dark": "addedBg", "light": "addedBg" },
    "diffRemovedBg": { "dark": "removedBg", "light": "removedBg" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "mutedDark", "light": "mutedDark" },
    "diffAddedLineNumberBg": { "dark": "addedBg", "light": "addedBg" },
    "diffRemovedLineNumberBg": { "dark": "removedBg", "light": "removedBg" },
    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "mutedDark", "light": "mutedDark" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "teal", "light": "teal" },
    "markdownImage": { "dark": "violet", "light": "violet" },
    "markdownImageText": { "dark": "violet", "light": "violet" },
    "markdownCodeBlock": { "dark": "textDim", "light": "textDim" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "violet", "light": "violet" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "yellow", "light": "yellow" },
    "syntaxType": { "dark": "teal", "light": "teal" },
    "syntaxOperator": { "dark": "indigo", "light": "indigo" },
    "syntaxPunctuation": { "dark": "textDim", "light": "textDim" }
  }
}

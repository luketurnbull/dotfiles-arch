{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tutor",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.secrets/context7_api_key}"
      }
    }
  },
  "agent": {
    "build": { "disable": false },
    "plan": { "disable": false },
    "general": { "disable": false }
  }
}

/* Obsidian theme sync snippet — dark mode only.
   Generated by theme-set from ~/.config/themes/current/obsidian.
   Do not edit by hand; re-run theme-set to refresh. */
.theme-dark {
  --background-primary: #0a0a0a;
  --background-primary-alt: #0a0a0a;
  --background-secondary: #0a0a0a;
  --background-secondary-alt: #0a0a0a;
  --background-modifier-border: #333333;
  --background-modifier-form-field: #1a1a1a;
  --background-modifier-form-field-highlighted: #333333;
  --background-modifier-box-shadow: rgba(0, 0, 0, 0.3);
  --background-modifier-success: #9fd08a;
  --background-modifier-error: #ff4d42;
  --background-modifier-error-hover: #ff6e64;
  --background-modifier-warning: #e6c15c;

  --text-normal: #ededed;
  --text-muted: #c9c9c9;
  --text-faint: #666666;
  --text-on-accent: #0a0a0a;
  --text-error: #ff4d42;
  --text-success: #9fd08a;
  --text-warning: #e6c15c;

  --interactive-normal: #1a1a1a;
  --interactive-hover: #333333;
  --interactive-accent: #ff3b30;
  --interactive-accent-hover: #ff6e64;
  --interactive-accent-rgb: 255, 59, 48;

  --link-color: #ff3b30;
  --link-color-hover: #ff6e64;
  --link-external-color: #7fb2e8;
  --link-external-color-hover: #9dc7f2;

  --code-background: #1a1a1a;
  --code-normal: #ededed;

  --scrollbar-bg: #0a0a0a;
  --scrollbar-thumb-bg: #333333;
}


/* Minimal chrome — hide tabs, ribbons, status bar, view headers */
.workspace-ribbon,
.status-bar,
.workspace-tab-header-container,
.view-header,
.nav-header,
.titlebar-button {
  display: none !important;
}

/* breathing room at top of file explorer */
.nav-files-container,
.workspace-leaf-content[data-type="file-explorer"] .view-content {
  padding-top: 24px !important;
}
